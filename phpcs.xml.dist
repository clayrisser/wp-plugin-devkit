<?xml version="1.0"?>
<ruleset name="Plugin Devkit">
	<description>Coding standards for the Plugin Devkit WordPress plugin.</description>

	<file>plugin-devkit</file>
	<file>tools.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress"/>

	<!-- Directory guard stubs keep the WP core "Silence is golden." idiom;
	     a file docblock would defeat their point. -->
	<rule ref="Squiz.Commenting.FileComment">
		<exclude-pattern>*/index\.php</exclude-pattern>
	</rule>

	<!-- The plugin (and wizard) must run on every PHP the plugin supports. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
